# ============================================================================
# REDMODE E-COMMERCE PLATFORM — ENVIRONMENT VARIABLES TEMPLATE
# Configure these variables in Vercel Project Settings -> Environment Variables
# NEVER commit real secrets, API tokens, or private keys to version control.
# ============================================================================

# 1. Server & Cryptographic Session Secrets
OTP_SECRET=replace_with_32_byte_random_hex_secret_for_otp_hmac
ADMIN_JWT_SECRET=replace_with_32_byte_random_hex_secret_for_admin_sessions
ADMIN_MASTER_USERNAME=admin
ADMIN_MASTER_PASSWORD=

# 2. Razorpay Domestic Payment Gateway (INR - UPI / Cards / NetBanking)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=live

# 3. PayPal Express International Payment Gateway (USD / Global Export)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live

# 4. Delhivery B2C Logistics & Surface Shipping API
DELHIVERY_API_TOKEN=
DELHIVERY_CLIENT_NAME=Redmode
DELHIVERY_WAREHOUSE_NAME=REDMODE B2C
DELHIVERY_PICKUP_PINCODE=250002

# 5. Customer & COD OTP Gateways (2Factor.in & Meta WhatsApp Cloud API)
TWOFACTOR_API_KEY=
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
