{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Registered administrators and staff members",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "format": "email" },
        "mobile": { "type": "string", "minLength": 10, "maxLength": 20 },
        "role": { "type": "string", "enum": ["Super Admin", "Listing + Label Admin", "Label Admin"] },
        "status": { "type": "string", "enum": ["active", "disabled"] },
        "lastLogin": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role", "status"]
    },
    "Product": {
      "title": "Product",
      "description": "Catalog products and updated listings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "mainImage": { "type": "string" }
      },
      "required": ["id", "name", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer e-commerce orders with hybrid WhatsApp automation and manual confirmation fallback state",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 4, "maxLength": 64 },
        "total": { "type": "number" },
        "paymentMode": { "type": "string", "enum": ["COD", "Prepaid"] },
        "orderStatus": { "type": "string" },
        "customerConfirmed": { "type": "boolean" },
        "customerConfirmedAt": { "type": "string" },
        "confirmationMethod": { "type": "string", "enum": ["WhatsApp", "Manual"] },
        "confirmedByAdminId": { "type": "string" },
        "confirmedByAdminName": { "type": "string" },
        "whatsappStatus": { "type": "string" },
        "whatsappDeliveryStatus": { "type": "string" },
        "whatsappMessageId": { "type": "string" },
        "whatsappError": { "type": "string" },
        "needsManualFollowUp": { "type": "boolean" },
        "manualFollowUpFlaggedAt": { "type": "string" },
        "manualFollowUpReason": { "type": "string" },
        "awb_number": { "type": "string" },
        "labelDownloaded": { "type": "boolean" },
        "labelDownloadedAt": { "type": "string" },
        "rtdAt": { "type": "string" },
        "pickedUpAt": { "type": "string" },
        "deliveredAt": { "type": "string" },
        "cancellationSource": { "type": "string", "enum": ["whatsapp_customer", "admin", "system"] },
        "cancelledByAdminId": { "type": "string" },
        "cancelledAt": { "type": "string" },
        "inventoryRestored": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "syncVersion": { "type": "number" }
      },
      "required": ["id", "total", "orderStatus", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Security and order confirmation audit trail for critical admin and automated actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "who": { "type": "string" },
        "adminId": { "type": "string" },
        "adminName": { "type": "string" },
        "role": { "type": "string" },
        "action": { "type": "string" },
        "entity": { "type": "string" },
        "entityId": { "type": "string" },
        "oldValue": { "type": "string" },
        "newValue": { "type": "string" },
        "confirmationMethod": { "type": "string" },
        "whatsappMessageId": { "type": "string" },
        "errorDetails": { "type": "string" },
        "timestamp": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "action", "who", "timestamp"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Registered administrators and staff members"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog products and updated listings"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders with hybrid WhatsApp and manual confirmation state"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Store categories and subcategories"
    },
    "/banners/{bannerId}": {
      "schema": "Banner",
      "description": "Storefront promotional and hero banners"
    },
    "/settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "Global store settings and payment configurations"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Append-only administrative and order confirmation audit logs"
    }
  }
}
